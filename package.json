{
  "name": "vite-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:all && vite build && npm run prune:r6 && npm run check:product-truth && npm run check:coaching-terms && npm run check:public-content && node scripts/audit-personal-data.mjs",
    "audit:personal": "node scripts/audit-personal-data.mjs",
    "generate:all": "npm run generate:content && npm run generate:brand && npm run generate:guides && npm run generate:operators && npm run generate:bans && npm run generate:blog && npm run generate:tools && npm run generate:coaching && npm run generate:countdown && npm run generate:rss && npm run generate:status && npm run generate:og && npm run generate:sitemap",
    "generate:content": "node scripts/generate-content-boundaries.mjs",
    "generate:games": "node scripts/generate-game-landing-pages.mjs",
    "generate:gameog": "node scripts/generate-game-og-images.mjs",
    "generate:stadiumog": "node scripts/generate-stadium-og-images.mjs",
    "generate:cast": "node scripts/generate-game-cast-pages.mjs",
    "generate:loadouts": "node scripts/generate-game-loadout-pages.mjs",
    "generate:maploadouts": "node scripts/generate-game-map-loadout-pages.mjs",
    "generate:tools": "node scripts/generate-tools-page.mjs",
    "generate:blog": "node scripts/generate-blog-posts.mjs",
    "generate:guides": "node scripts/generate-guides.mjs",
    "generate:operators": "node scripts/generate-operator-guides.mjs",
    "generate:bans": "node scripts/generate-ban-guides.mjs",
    "generate:rss": "node scripts/generate-rss-feed.mjs",
    "generate:status": "node scripts/generate-status-page.mjs",
    "generate:og": "node scripts/generate-og-images.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "postdeploy": "npm run indexnow",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:countdown": "node scripts/generate-countdown.mjs",
    "generate:coaching": "node scripts/generate-coaching-page.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "prune:r6": "node scripts/prune-non-r6-output.mjs",
    "check:product-truth": "node scripts/check-product-truth.mjs",
    "check:coaching-terms": "node scripts/check-coaching-terms.mjs",
    "check:public-content": "node scripts/audit-public-content.mjs",
    "check:auth-health": "node scripts/check-auth-health.mjs",
    "test:coaching-addon": "node --test lambda/webhook/coaching-addon.test.mjs lambda/booking/coaching-credits.test.mjs",
    "test:workbook-purchase": "node --test lambda/subscription/workbook-purchase.test.mjs"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "amazon-cognito-identity-js": "^6.3.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
