VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_PLAYER_DATA_API_URL=https://your-player-data-api-id.execute-api.us-east-1.amazonaws.com/prod

# Desktop app release gate. Unset (or anything but "true") keeps /download
# redirecting to /account, keeps the desktop links out of the navbar and
# welcome modal, and keeps /download out of the sitemap — all three are
# enforced by `npm run check:truth`. Flip this to true only when the desktop
# app actually ships; check:truth has to be relaxed in the same change.
# VITE_DESKTOP_APP_RELEASED=false
