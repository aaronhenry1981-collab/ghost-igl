VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Required for a production deploy since 2026-09-28 (deploy.ps1 refuses
# without them). Stack outputs: recon-customer-success (CustomerSuccessApiUrl)
# and recon-player-data-prod (PlayerDataApiUrl).
VITE_CUSTOMER_SUCCESS_API_URL=https://your-cs-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_PLAYER_DATA_API_URL=https://your-player-data-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_SUPPORT_UI=true
# Leave unset until Help Center articles are reviewed and published.
# VITE_HELP_CENTER_UI=true
