{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated Recon squad preview. No hosting grant is created. Existing APIs, paid accounts and capture pilot are untouched.",
  "Parameters": {
    "CodeS3Key": {
      "Type": "String",
      "AllowedPattern": "recon-squad/[a-f0-9]{64}/lambda.zip"
    },
    "CodeSha256": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9+/]{43}="
    }
  },
  "Resources": {
    "SquadTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "recon-squad-state",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "ReconSquadPreview"
          }
        ]
      }
    },
    "SquadGrantsTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "recon-squad-grants",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "ReconSquadPreview"
          }
        ]
      }
    },
    "SquadHttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "recon-squad-preview-http",
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            "https://r6coaching.com",
            "https://www.r6coaching.com"
          ],
          "AllowHeaders": [
            "Authorization",
            "Content-Type"
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "PUT"
          ],
          "MaxAge": 600
        }
      }
    },
    "SquadWsApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "recon-squad-preview-ws",
        "ProtocolType": "WEBSOCKET",
        "RouteSelectionExpression": "$request.body.type"
      }
    },
    "SquadRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "recon-squad-api-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "recon-squad-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadDedicatedSquadState",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:183678667221:table/recon-squad-state",
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ROOM#*",
                        "CREATE#*",
                        "USAGE#*",
                        "TICKET#*",
                        "CONNECTION#*",
                        "USER#*",
                        "OWNER_USAGE#*"
                      ]
                    },
                    "Null": {
                      "dynamodb:LeadingKeys": "false"
                    }
                  }
                },
                {
                  "Sid": "ReadHostingGrant",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:183678667221:table/recon-squad-grants"
                },
                {
                  "Sid": "QueryOnlyRoomConnectionsAndOwnedHistory",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Query"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:183678667221:table/recon-squad-state",
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ROOM#*",
                        "USER#*"
                      ]
                    },
                    "Null": {
                      "dynamodb:LeadingKeys": "false"
                    }
                  }
                },
                {
                  "Sid": "WriteOnlyTransactionalSquadState",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:183678667221:table/recon-squad-state",
                  "Condition": {
                    "StringEquals": {
                      "dynamodb:EnclosingOperation": "TransactWriteItems"
                    }
                  }
                },
                {
                  "Sid": "CheckGrantWithoutChangingIt",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:183678667221:table/recon-squad-grants",
                  "Condition": {
                    "StringEquals": {
                      "dynamodb:EnclosingOperation": "TransactWriteItems"
                    }
                  }
                },
                {
                  "Sid": "DenyAllOtherHostingGrantAccess",
                  "Effect": "Deny",
                  "NotAction": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:183678667221:table/recon-squad-grants"
                },
                {
                  "Sid": "ManageOnlyThisVoiceFreeSocketApi",
                  "Effect": "Allow",
                  "Action": [
                    "execute-api:ManageConnections"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": [
                        "arn:aws:execute-api:us-east-1:183678667221:${Api}/prod/POST/@connections/*",
                        {
                          "Api": {
                            "Ref": "SquadWsApi"
                          }
                        }
                      ]
                    },
                    {
                      "Fn::Sub": [
                        "arn:aws:execute-api:us-east-1:183678667221:${Api}/prod/DELETE/@connections/*",
                        {
                          "Api": {
                            "Ref": "SquadWsApi"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "Sid": "WriteOnlyThisFunctionsLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:us-east-1:183678667221:log-group:/aws/lambda/recon-squad-api:*"
                }
              ]
            }
          }
        ]
      }
    },
    "SquadLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/aws/lambda/recon-squad-api",
